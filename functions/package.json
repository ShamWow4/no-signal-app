    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.3.0",
    "google-auth-library": "^10.9.0",
    "google-spreadsheet": "^5.3.0",
    "puppeteer": "^25.3.0"
  },
  "private": true,
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "@firebase/util@1.15.1": true
  }
